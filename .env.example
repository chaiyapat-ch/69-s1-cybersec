## - ห้าม commit ไฟล์ .env (อยู่ใน .gitignore แล้ว)
## ============================================================

## --- ADMIN ---
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password
ADMIN_FIRSTNAME=YourFirstName
ADMIN_LASTNAME=YourLastName
ADMIN_RESET_TOKEN=your_reset_token
ADMIN_NEW_PASSWORD=your_new_password

## --- USER ---
USER_EMAIL=your_user_email
USER_USERNAME=your_username
USER_PASSWORD=your_user_password
USER_RESET_CODE=your_reset_code
USER_NEW_PASSWORD=your_new_password

## --- STUDENT ---
