### =========================================================================
### 1. ADMIN OPERATIONS (Strapi Admin)
### =========================================================================

### 1.1 Admin - Login (เข้าสู่ระบบแอดมิน)
# @name adminLogin
POST http://localhost:9091/admin/login
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}"
}

###

### 1.2 Admin - Register (ลงทะเบียนแอดมินคนแรก)
POST http://localhost:9091/admin/register-admin
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}",
    "firstname": "{{$dotenv ADMIN_FIRSTNAME}}",
    "lastname": "{{$dotenv ADMIN_LASTNAME}}"
}

###

### 1.3 Admin - Forgot Password (ลืมรหัสผ่านแอดมิน)
### หมายเหตุ: Endpoint นี้ตอบ 204 No Content เสมอเพื่อความปลอดภัย
POST http://localhost:9091/admin/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}"
}

###

### 1.4 Admin - Reset Password (ตั้งรหัสผ่านใหม่แอดมิน)
POST http://localhost:9091/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{$dotenv ADMIN_RESET_TOKEN}}",
    "password": "{{$dotenv ADMIN_NEW_PASSWORD}}"
}

###

### 1.5 Admin - Profile (ดูข้อมูลส่วนตัวแอดมิน)
GET http://localhost:9091/admin/users/me
Authorization: Bearer {{adminLogin.response.body.data.token}}



### ==========================================
###  2. USER API (ระบบสมาชิกทั่วไป)
### ==========================================

###  2.6 USER LOGIN (เข้าสู่ระบบสมาชิก)
# @name userLogin
POST http://localhost:9091/api/auth/local
Content-Type: application/json

{
    "identifier": "{{$dotenv USER_EMAIL}}",
    "password": "{{$dotenv USER_PASSWORD}}"
}


### 2.7 USER REGISTER (สมัครสมาชิก)
POST http://localhost:9091/api/auth/local/register
Content-Type: application/json

{
    "username": "{{$dotenv USER_USERNAME}}",
    "email": "{{$dotenv USER_EMAIL}}",
    "password": "{{$dotenv USER_PASSWORD}}"
}


### 2.8 USER FORGOT PASSWORD (ลืมรหัสผ่านสมาชิก)
POST http://localhost:9091/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv USER_EMAIL}}"
}


### 2.9 USER RESET PASSWORD (รีเซ็ตรหัสผ่านสมาชิก)
POST http://localhost:9091/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{$dotenv USER_RESET_CODE}}",
    "password": "{{$dotenv USER_NEW_PASSWORD}}",
    "passwordConfirmation": "{{$dotenv USER_NEW_PASSWORD}}"
}


### 2.10 USER PROFILE (ดูข้อมูลส่วนตัวสมาชิก)
# รัน USER LOGIN (ข้อ 2.6) ก่อน เพื่อรับ JWT ใหม่
GET http://localhost:9091/api/users/me
Authorization: Bearer {{userLogin.response.body.jwt}}



### =========================================================================
### 3. CONTENT SECTION (ระบบจัดการเนื้อหา)
### หมายเหตุ: ทุกข้อใน section นี้ต้องรัน USER LOGIN (ข้อ 2.6) ก่อน เพื่อรับ JWT
### =========================================================================

### 3.1 STUDENT (นักศึกษา)

### 3.1.1 Student - Create (สร้างนักศึกษา)
# @name studentCreate
POST http://localhost:9091/api/students
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv STUDENT_NAME}}",
        "mobile": "{{$dotenv STUDENT_MOBILE}}",
        "cardId": "{{$dotenv STUDENT_CARD_ID}}"
    }
}

###

### 3.1.2 Student - List All (ดูรายการนักศึกษาทั้งหมด)
GET http://localhost:9091/api/students
Authorization: Bearer {{userLogin.response.body.jwt}}

###

### 3.1.3 Student - List with ID (ดูนักศึกษาตาม id)
# รันข้อ 3.1.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
GET http://localhost:9091/api/students/{{studentCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

###

### 3.1.4 Student - Update (แก้ไขข้อมูลนักศึกษา)
# รันข้อ 3.1.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
PUT http://localhost:9091/api/students/{{studentCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv STUDENT_NAME_UPDATED}}"
    }
}

###

### 3.1.5 Student - Delete (ลบนักศึกษา)
# รันข้อ 3.1.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
DELETE http://localhost:9091/api/students/{{studentCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

### 3.2 SUBJECT (รายวิชา)
### 3.2.1 Subject - Create (สร้างรายวิชา)
# @name subjectCreate
POST http://localhost:9091/api/subjects
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv SUBJECT_NAME}}"
    }
}

###

### 3.2.2 Subject - List All (ดูรายวิชาทั้งหมด)
GET http://localhost:9091/api/subjects
Authorization: Bearer {{userLogin.response.body.jwt}}

###

### 3.2.3 Subject - List with ID (ดูรายวิชาตาม id)
# รันข้อ 3.2.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
GET http://localhost:9091/api/subjects/{{subjectCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

###

### 3.2.4 Subject - Update (แก้ไขรายวิชา)
# รันข้อ 3.2.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
PUT http://localhost:9091/api/subjects/{{subjectCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv SUBJECT_NAME_UPDATED}}"
    }
}

###

### 3.2.5 Subject - Delete (ลบรายวิชา)
# รันข้อ 3.2.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
DELETE http://localhost:9091/api/subjects/{{subjectCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

### -------------------------------------------------------------------------
### 3.3 TEACHER (อาจารย์)
### -------------------------------------------------------------------------

### 3.3.1 Teacher - Create (สร้างอาจารย์)
# @name teacherCreate
POST http://localhost:9091/api/teachers
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv TEACHER_NAME}}"
    }
}

###

### 3.3.2 Teacher - List All (ดูรายการอาจารย์ทั้งหมด)
GET http://localhost:9091/api/teachers
Authorization: Bearer {{userLogin.response.body.jwt}}

###

### 3.3.3 Teacher - List with ID (ดูอาจารย์ตาม id)
# รันข้อ 3.3.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
GET http://localhost:9091/api/teachers/{{teacherCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

###

### 3.3.4 Teacher - Update (แก้ไขข้อมูลอาจารย์)
# รันข้อ 3.3.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
PUT http://localhost:9091/api/teachers/{{teacherCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv TEACHER_NAME_UPDATED}}"
    }
}

###

### 3.3.5 Teacher - Delete (ลบอาจารย์)
# รันข้อ 3.3.1 ก่อน เพื่อให้ดึง id อัตโนมัติ
DELETE http://localhost:9091/api/teachers/{{teacherCreate.response.body.data.id}}
Authorization: Bearer {{userLogin.response.body.jwt}}

